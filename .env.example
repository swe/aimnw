API_DRINKS=
# Finished-books list URL, e.g. https://api.alleksy.com/books/finished
API_LIBRARY=
API_MAP=
API_GOALS=
API_HATES=
API_PHOTOS=
API_QUESTS=

# Server-only MapKit JS domain token (Certificates → Services → Maps → Tokens).
# Restrict to localhost + production domains. Served at /api/mapkit-token — never
# baked into the client bundle.
MAPKIT_TOKEN=

# Server-only Discogs credentials (never shipped to the browser).
DISCOGS_USERNAME=
DISCOGS_TOKEN=

# Server-only Joplin Server credentials (never shipped to the browser).
# Notebook id = parent_id of a note in that folder.
JOPLIN_BASE_URL=
JOPLIN_EMAIL=
JOPLIN_PASSWORD=
JOPLIN_FOLDER_ID=
JOPLIN_USE_FOLDER_ID=

# Server-only Oura Ring token (workouts → sport hub). Never ship to the browser.
# Create a personal/OAuth access token at https://cloud.ouraring.com
OURA_ACCESS_TOKEN=
# Optional OAuth refresh (when the access token expires):
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=
# OURA_REFRESH_TOKEN=
# Fitness Age + VO₂ max need heart_health scope — run: pnpm oura:oauth

# Server-only Hevy API key (gym volume / body measurements).
HEVY_API_KEY=

# Garmin Connect has no personal API, so /sport signs in through the app's SSO.
# Run `pnpm garmin:login` once — tokens land in .garmin-session.json (gitignored).
# If those two are set, the server will try a one-shot login (MFA still needs the script).
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
# Optional: move the session file (relative paths resolve from the repo root).
# GARMIN_SESSION_FILE=.garmin-session.json

# Optional: how long the server reuses a Hevy / Oura / Garmin summary (ms, default 600000).
# HEVY_CACHE_TTL_MS=
# OURA_CACHE_TTL_MS=
# GARMIN_CACHE_TTL_MS=

# Server-only Telegram bot for the site contact form. Never ship these to the browser.
# Create a bot with @BotFather, then message it once and read chat id via getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
